# VKU Real-time Study Room Booking App Environment Configuration

# Choose data mode: 'mock' (default, runs in-memory without credentials) or 'supabase'
EXPO_PUBLIC_APP_DATA_MODE=mock

# Supabase Credentials (required only if EXPO_PUBLIC_APP_DATA_MODE=supabase)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
